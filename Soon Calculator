import tkinter as tk
import math

def click(value):
    current = entry.get()
    entry.delete(0, tk.END)
    entry.insert(0, current + str(value))

def clear():
    entry.delete(0, tk.END)

def backspace():
    current = entry.get()
    entry.delete(0, tk.END)
    entry.insert(0, current[:-1])

def calculate():
    try:
        expr = entry.get().replace('^', '**')
        result = eval(expr)
        entry.delete(0, tk.END)
        entry.insert(0, str(result))
    except:
        entry.delete(0, tk.END)
        entry.insert(0, "خطأ")

def calculate_sqrt():
    try:
        val = float(entry.get())
        if val < 0:
            entry.delete(0, tk.END)
            entry.insert(0, "خطأ: رقم سالب")
        else:
            result = math.sqrt(val)
            entry.delete(0, tk.END)
            entry.insert(0, str(result))
    except:
        entry.delete(0, tk.END)
        entry.insert(0, "خطأ")

# إعداد نافذة التطبيق
root = tk.Tk()
root.title("آلة حاسبة متطورة")
root.geometry("320x520")
root.config(bg="#121212")

# شاشة العرض
entry = tk.Entry(root, font=("Arial", 26, "bold"), bg="#1e1e1e", fg="#ffffff", bd=0, justify="right")
entry.pack(fill=tk.BOTH, ipadx=10, ipady=15, padx=15, pady=15)

# إطار الأزرار
buttons_frame = tk.Frame(root, bg="#121212")
buttons_frame.pack()

# قائمة الأزرار
buttons = [
    ('C', 1, 0), ('⌫', 1, 1), ('√', 1, 2), ('/', 1, 3),
    ('7', 2, 0), ('8', 2, 1), ('9', 2, 2), ('*', 2, 3),
    ('4', 3, 0), ('5', 3, 1), ('6', 3, 2), ('-', 3, 3),
    ('1', 4, 0), ('2', 4, 1), ('3', 4, 2), ('+', 4, 3),
    ('0', 5, 0), ('.', 5, 1), ('^', 5, 2), ('=', 5, 3)
]

for (text, row, col) in buttons:
    if text == '=':
        bg_color = "#34c759"
    elif text in ('/', '*', '-', '+'):
        bg_color = "#ff9f0a"
    elif text in ('C', '⌫', '√', '^'):
        bg_color = "#505052"
    else:
        bg_color = "#2c2c2e"

    if text == '√':
        cmd = calculate_sqrt
    elif text == 'C':
        cmd = clear
    elif text == '⌫':
        cmd = backspace
    elif text == '=':
        cmd = calculate
    else:
        cmd = lambda t=text: click(t)

    btn = tk.Button(buttons_frame, text=text, font=("Arial", 18, "bold"), bg=bg_color, fg="#ffffff", width=4, height=2, bd=0, command=cmd)
    btn.grid(row=row, column=col, padx=6, pady=6)

root.mainloop()
